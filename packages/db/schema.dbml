enum actor_type {
  customer
  operator
  admin
  system
  stripe
}

enum auction_source {
  copart
  iaai
}

enum bid_payment_status {
  not_required
  pending
  paid
  overdue
  forfeited
}

enum bid_status {
  pending
  locked
  placed
  won_pending_approval
  won
  lost
  not_placed
  cancelled
  outbid
}

enum buying_power_entry_kind {
  grant
  revoke
  reserve
  release
  consume
  restore
  adjust_up
  adjust_down
}

enum customer_type {
  individual
  company
}

enum deposit_status {
  pending
  succeeded
  failed
  canceled
  closed
}

enum deposit_tx_kind {
  payment
  refund
  forfeit
  apply_to_purchase
  dispute_opened
  dispute_won
  dispute_lost
}

enum export_status {
  green
  red
  black
  double_red
  unknown
}

enum kyc_provider {
  ondato
  veriff
}

enum kyc_status {
  created
  pending
  approved
  declined
  resubmission_requested
  expired
  abandoned
}

enum lot_status {
  upcoming
  live
  sold
  on_approval
  not_sold
  removed
  unknown
}

enum notification_channel {
  email
  telegram
}

enum notification_status {
  queued
  sending
  sent
  failed
}

enum odometer_brand {
  actual
  exempt
  not_actual
  exceeds_mechanical
  unknown
}

enum payment_method {
  card
  bank_transfer
}

enum port_kind {
  us_export
  eu_import
}

enum rate_card_status {
  draft
  active
  archived
}

enum sale_outcome {
  sold
  on_approval
  not_sold
  cancelled
  unknown
}

enum shipping_method {
  container
  roro
}

enum sync_status {
  running
  succeeded
  failed
}

enum tx_origin {
  platform
  stripe_dashboard
  system
}

enum vehicle_type {
  car
  motorcycle
  truck
  atv
  other
}

table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at "timestamp with time zone"
  refresh_token_expires_at "timestamp with time zone"
  scope text
  password text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'account_user_idx']
  }
}

table auction_fee_bands {
  id bigint [pk, not null]
  rate_card_id bigint [not null]
  source auction_source [not null]
  fee_code text [not null]
  price_from_cents bigint [not null]
  price_to_cents bigint
  flat_usd_cents bigint
  percent "numeric(6, 3)"

  indexes {
    (rate_card_id, source, fee_code, price_from_cents) [name: 'fee_bands_lookup_idx']
    
  }
}

table audit_log {
  id bigint [pk, not null]
  actor_user_id text
  action text [not null]
  entity_type text [not null]
  entity_id text [not null]
  before jsonb
  after jsonb
  ip_address text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (entity_type, entity_id) [name: 'audit_entity_idx']
    (actor_user_id, created_at) [name: 'audit_actor_idx']
  }
}

table bid_events {
  id bigint [pk, not null]
  bid_id bigint [not null]
  from_status bid_status
  to_status bid_status [not null]
  from_amount_usd_cents bigint
  to_amount_usd_cents bigint
  actor_type actor_type [not null]
  actor_id text
  reason text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (bid_id, created_at) [name: 'bid_events_bid_idx']
  }
}

table bids {
  id bigint [pk, not null]
  user_id text [not null]
  lot_id bigint [not null]
  max_bid_usd_cents bigint [not null]
  is_buy_now boolean [not null, default: false]
  status bid_status [not null, default: 'pending']
  sale_at_when_placed "timestamp with time zone"
  cutoff_at "timestamp with time zone"
  lot_snapshot jsonb [not null]
  quote_id bigint
  plan_version_id bigint
  terms_version text [not null]
  placed_by text
  placed_at "timestamp with time zone"
  final_price_usd_cents bigint
  result_at "timestamp with time zone"
  result_set_by text
  payment_status bid_payment_status [not null, default: 'not_required']
  payment_due_at "timestamp with time zone"
  paid_marked_at "timestamp with time zone"
  outbid_by_bid_id bigint
  idempotency_key text [not null, unique]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    lot_id [name: 'bids_one_active_per_lot_uq', unique]
    (user_id, status) [name: 'bids_user_status_idx']
    (status, cutoff_at) [name: 'bids_status_cutoff_idx']
    lot_id [name: 'bids_lot_idx']
    
  }
}

table buying_power_accounts {
  user_id text [pk, not null]
  granted_usd_cents bigint [not null, default: 0]
  reserved_usd_cents bigint [not null, default: 0]
  consumed_usd_cents bigint [not null, default: 0]
  plan_version_id bigint
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table buying_power_entries {
  id bigint [pk, not null]
  user_id text [not null]
  kind buying_power_entry_kind [not null]
  amount_usd_cents bigint [not null]
  deposit_id bigint
  bid_id bigint
  actor_type actor_type [not null]
  actor_id text
  reason text
  idempotency_key text [unique]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'bp_entries_user_idx']
    
  }
}

table customer_profiles {
  user_id text [pk, not null]
  type customer_type [not null, default: 'individual']
  first_name text
  last_name text
  company_name text
  company_code text
  vat_number text
  vat_verified_at "timestamp with time zone"
  country char(2)
  city text
  address text
  phone text
  phone_verified_at "timestamp with time zone"
  locale text [not null, default: 'lt']
  stripe_customer_id text [unique]
  kyc_approved_at "timestamp with time zone"
  bidding_blocked_at "timestamp with time zone"
  bidding_blocked_reason text
  broker_notes text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table deposit_transactions {
  id bigint [pk, not null]
  deposit_id bigint [not null]
  kind deposit_tx_kind [not null]
  origin tx_origin [not null]
  amount_eur_cents bigint [not null]
  stripe_object_id text
  bid_id bigint
  idempotency_key text [unique]
  reason text
  created_by text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    deposit_id [name: 'deposit_tx_deposit_idx']
    (stripe_object_id, kind) [name: 'deposit_tx_stripe_kind_uq', unique]
    
    
  }
}

table deposits {
  id bigint [pk, not null]
  user_id text [not null]
  plan_version_id bigint [not null]
  upgrades_deposit_id bigint
  amount_eur_cents bigint [not null]
  grants_buying_power_usd_cents bigint [not null]
  status deposit_status [not null, default: 'pending']
  payment_method payment_method
  stripe_checkout_session_id text [unique]
  stripe_payment_intent_id text [unique]
  succeeded_at "timestamp with time zone"
  refund_requested_at "timestamp with time zone"
  closed_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'deposits_user_idx']
    
  }
}

table favorites {
  user_id text [not null]
  lot_id bigint [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, lot_id) [pk]
    lot_id [name: 'favorites_lot_idx']
  }
}

table fixed_fees {
  id bigint [pk, not null]
  rate_card_id bigint [not null]
  code text [not null]
  label text [not null]
  currency char(3) [not null]
  amount_cents bigint
  percent "numeric(6, 3)"
  vat_rate "numeric(5, 2)"
  vehicle_type vehicle_type
  is_optional boolean [not null, default: false]
  in_vat_base boolean [not null, default: false]

  indexes {
    (rate_card_id, code, vehicle_type) [name: 'fixed_fees_uq', unique]
  }
}

table fx_rates {
  rate_date date [not null]
  base char(3) [not null]
  quote char(3) [not null]
  rate "numeric(14, 6)" [not null]
  source text [not null]
  fetched_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (rate_date, base, quote) [pk]
  }
}

table kyc_checks {
  id bigint [pk, not null]
  user_id text [not null]
  provider kyc_provider [not null]
  provider_session_id text [not null]
  status kyc_status [not null, default: 'created']
  decision_reason text
  decided_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (provider, provider_session_id) [name: 'kyc_provider_session_uq', unique]
    user_id [name: 'kyc_user_idx']
  }
}

table lot_raw {
  lot_id bigint [pk, not null]
  provider text [not null]
  payload jsonb [not null]
  received_at "timestamp with time zone" [not null, default: `now()`]
}

table lot_sales {
  id bigint [pk, not null]
  lot_id bigint [not null]
  sale_at "timestamp with time zone" [not null]
  outcome sale_outcome [not null]
  final_bid_usd_cents bigint
  odometer_at_sale integer
  recorded_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (lot_id, sale_at) [name: 'lot_sales_lot_sale_uq', unique]
    sale_at [name: 'lot_sales_sale_at_idx']
  }
}

table lots {
  id bigint [pk, not null]
  source auction_source [not null]
  external_lot_id text [not null]
  vehicle_id bigint [not null]
  yard_id bigint
  status lot_status [not null, default: 'upcoming']
  sale_at "timestamp with time zone"
  odometer integer
  odometer_unit text [not null, default: 'mi']
  odometer_brand odometer_brand [not null, default: 'unknown']
  primary_damage text
  secondary_damage text
  has_keys boolean
  run_condition text
  title_type text
  title_state char(2)
  sale_document text
  export_status export_status [not null, default: 'unknown']
  seller_type text
  seller_name text
  current_bid_usd_cents bigint
  buy_now_usd_cents bigint
  est_retail_usd_cents bigint
  on_approval boolean
  images jsonb [not null, default: `'[]'::jsonb`]
  has_video_360 boolean [not null, default: false]
  export_status_override export_status
  source_updated_at "timestamp with time zone"
  synced_at "timestamp with time zone" [not null, default: `now()`]
  hidden_at "timestamp with time zone"
  reviewed_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (source, external_lot_id) [name: 'lots_source_external_uq', unique]
    vehicle_id [name: 'lots_vehicle_idx']
    (status, sale_at) [name: 'lots_status_sale_idx']
    synced_at [name: 'lots_synced_idx']
  }
}

table notifications {
  id bigint [pk, not null]
  channel notification_channel [not null]
  recipient text [not null]
  user_id text
  template text [not null]
  payload jsonb [not null]
  status notification_status [not null, default: 'queued']
  attempts integer [not null, default: 0]
  last_error text
  bid_id bigint
  next_attempt_at "timestamp with time zone" [not null, default: `now()`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  sent_at "timestamp with time zone"

  indexes {
    (status, next_attempt_at) [name: 'notifications_queue_idx']
  }
}

table ocean_rates {
  id bigint [pk, not null]
  rate_card_id bigint [not null]
  from_port_id bigint [not null]
  to_port_id bigint [not null]
  vehicle_type vehicle_type [not null, default: 'car']
  method shipping_method [not null, default: 'container']
  price_usd_cents bigint [not null]
  transit_days_min integer
  transit_days_max integer

  indexes {
    (rate_card_id, from_port_id, to_port_id, vehicle_type, method) [name: 'ocean_rates_uq', unique]
  }
}

table plan_versions {
  id bigint [pk, not null]
  plan_id bigint [not null]
  version integer [not null]
  deposit_eur_cents bigint [not null]
  buying_power_usd_cents bigint [not null]
  max_active_bids integer [not null]
  max_bid_per_lot_usd_cents bigint
  stripe_price_id text
  effective_from "timestamp with time zone" [not null, default: `now()`]
  effective_to "timestamp with time zone"
  created_by text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (plan_id, version) [name: 'plan_versions_plan_version_uq', unique]
    
  }
}

table plans {
  id bigint [pk, not null]
  code text [not null, unique]
  name text [not null]
  is_public boolean [not null, default: true]
  is_active boolean [not null, default: true]
  assigned_user_id text
  sort_order integer [not null, default: 0]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table ports {
  id bigint [pk, not null]
  code text [not null, unique]
  name text [not null]
  country char(2) [not null]
  kind port_kind [not null]
  is_active boolean [not null, default: true]
}

table quotes {
  id bigint [pk, not null]
  lot_id bigint
  user_id text
  bid_usd_cents bigint [not null]
  rate_card_id bigint [not null]
  fx_rate_date date [not null]
  fx_rate "numeric(14, 6)" [not null]
  inputs jsonb [not null]
  lines jsonb [not null]
  total_eur_cents bigint
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table rate_cards {
  id bigint [pk, not null]
  name text [not null]
  status rate_card_status [not null, default: 'draft']
  notes text
  published_at "timestamp with time zone"
  published_by text
  created_by text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    status [name: 'rate_cards_one_active_uq', unique]
  }
}

table saved_searches {
  id bigint [pk, not null]
  user_id text [not null]
  name text [not null]
  query jsonb [not null]
  alerts_enabled boolean [not null, default: true]
  last_notified_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'saved_searches_user_idx']
  }
}

table session {
  id text [pk, not null]
  expires_at "timestamp with time zone" [not null]
  token text [not null, unique]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text

  indexes {
    user_id [name: 'session_user_idx']
  }
}

table site_settings {
  key text [pk, not null]
  value jsonb [not null]
  updated_by text
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table stripe_events {
  id text [pk, not null]
  type text [not null]
  payload jsonb [not null]
  received_at "timestamp with time zone" [not null, default: `now()`]
  processed_at "timestamp with time zone"
  error text

  indexes {
    received_at [name: 'stripe_events_unprocessed_idx']
  }
}

table sync_runs {
  id bigint [pk, not null]
  provider text [not null]
  feed text [not null]
  status sync_status [not null, default: 'running']
  cursor_from text
  cursor_to text
  lots_upserted integer [not null, default: 0]
  lots_removed integer [not null, default: 0]
  requests_used integer [not null, default: 0]
  error text
  started_at "timestamp with time zone" [not null, default: `now()`]
  finished_at "timestamp with time zone"

  indexes {
    (provider, feed, started_at) [name: 'sync_runs_feed_started_idx']
  }
}

table tax_rates {
  id bigint [pk, not null]
  rate_card_id bigint [not null]
  code text [not null]
  rate_percent "numeric(6, 3)" [not null]
  basis text [not null]
  notes text

  indexes {
    (rate_card_id, code) [name: 'tax_rates_uq', unique]
  }
}

table towing_rates {
  id bigint [pk, not null]
  rate_card_id bigint [not null]
  yard_id bigint
  state char(2)
  port_id bigint [not null]
  vehicle_type vehicle_type [not null, default: 'car']
  price_usd_cents bigint [not null]

  indexes {
    (rate_card_id, yard_id, state) [name: 'towing_lookup_idx']
    
  }
}

table two_factor {
  id text [pk, not null]
  secret text [not null]
  backup_codes text [not null]
  user_id text [not null]
  verified boolean [default: true]
  failed_verification_count integer [default: 0]
  locked_until "timestamp with time zone"

  indexes {
    secret [name: 'two_factor_secret_idx']
    user_id [name: 'two_factor_user_idx']
  }
}

table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
  role text [not null, default: 'customer']
  banned boolean [default: false]
  ban_reason text
  ban_expires "timestamp with time zone"
  two_factor_enabled boolean [default: false]
}

table vehicles {
  id bigint [pk, not null]
  vin text
  year integer
  make text
  model text
  trim text
  body_style text
  vehicle_type vehicle_type [not null, default: 'car']
  engine text
  cylinders integer
  fuel text
  drive text
  transmission text
  color text
  vin_decode jsonb
  vin_decoded_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    vin [name: 'vehicles_vin_uq', unique]
    (make, model, year) [name: 'vehicles_make_model_idx']
  }
}

table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

table yards {
  id bigint [pk, not null]
  source auction_source [not null]
  external_code text [not null]
  name text [not null]
  city text
  state char(2)
  zip text
  country char(2) [not null, default: 'US']
  timezone text
  lat "numeric(9, 6)"
  lon "numeric(9, 6)"

  indexes {
    (source, external_code) [name: 'yards_source_code_uq', unique]
  }
}

ref account_user_id_user_id_fk: account.user_id > user.id [delete: cascade, update: no action]

ref auction_fee_bands_rate_card_id_rate_cards_id_fk: auction_fee_bands.rate_card_id > rate_cards.id [delete: cascade, update: no action]

ref audit_log_actor_user_id_user_id_fk: audit_log.actor_user_id > user.id [delete: no action, update: no action]

ref bid_events_bid_id_bids_id_fk: bid_events.bid_id > bids.id [delete: no action, update: no action]

ref bids_user_id_user_id_fk: bids.user_id > user.id [delete: no action, update: no action]

ref bids_lot_id_lots_id_fk: bids.lot_id > lots.id [delete: no action, update: no action]

ref bids_quote_id_quotes_id_fk: bids.quote_id > quotes.id [delete: no action, update: no action]

ref bids_plan_version_id_plan_versions_id_fk: bids.plan_version_id > plan_versions.id [delete: no action, update: no action]

ref bids_placed_by_user_id_fk: bids.placed_by > user.id [delete: no action, update: no action]

ref bids_result_set_by_user_id_fk: bids.result_set_by > user.id [delete: no action, update: no action]

ref bids_outbid_by_bid_id_bids_id_fk: bids.outbid_by_bid_id > bids.id [delete: no action, update: no action]

ref buying_power_accounts_user_id_user_id_fk: buying_power_accounts.user_id > user.id [delete: no action, update: no action]

ref buying_power_accounts_plan_version_id_plan_versions_id_fk: buying_power_accounts.plan_version_id > plan_versions.id [delete: no action, update: no action]

ref buying_power_entries_user_id_buying_power_accounts_user_id_fk: buying_power_entries.user_id > buying_power_accounts.user_id [delete: no action, update: no action]

ref buying_power_entries_deposit_id_deposits_id_fk: buying_power_entries.deposit_id > deposits.id [delete: no action, update: no action]

ref buying_power_entries_bid_id_bids_id_fk: buying_power_entries.bid_id > bids.id [delete: no action, update: no action]

ref customer_profiles_user_id_user_id_fk: customer_profiles.user_id > user.id [delete: cascade, update: no action]

ref deposit_transactions_deposit_id_deposits_id_fk: deposit_transactions.deposit_id > deposits.id [delete: no action, update: no action]

ref deposit_transactions_bid_id_bids_id_fk: deposit_transactions.bid_id > bids.id [delete: no action, update: no action]

ref deposit_transactions_created_by_user_id_fk: deposit_transactions.created_by > user.id [delete: no action, update: no action]

ref deposits_user_id_user_id_fk: deposits.user_id > user.id [delete: no action, update: no action]

ref deposits_plan_version_id_plan_versions_id_fk: deposits.plan_version_id > plan_versions.id [delete: no action, update: no action]

ref deposits_upgrades_deposit_id_deposits_id_fk: deposits.upgrades_deposit_id > deposits.id [delete: no action, update: no action]

ref favorites_user_id_user_id_fk: favorites.user_id > user.id [delete: cascade, update: no action]

ref favorites_lot_id_lots_id_fk: favorites.lot_id > lots.id [delete: cascade, update: no action]

ref fixed_fees_rate_card_id_rate_cards_id_fk: fixed_fees.rate_card_id > rate_cards.id [delete: cascade, update: no action]

