{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "APP_ENV",
    "NODE_ENV",
    "LOT_PROVIDER",
    "KYC_PROVIDER",
    "PAYMENT_PROVIDER",
    "EMAIL_TRANSPORT",
    "TELEGRAM_TRANSPORT",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "SMTP_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "APIBARA_API_KEY",
    "APIBARA_BASE_URL",
    "ONDATO_CLIENT_ID",
    "ONDATO_CLIENT_SECRET",
    "ONDATO_WEBHOOK_SECRET",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "TELEGRAM_BOT_TOKEN",
    "TURNSTILE_SECRET_KEY",
    "SENTRY_DSN",
    "BETTERSTACK_HEARTBEAT_URL"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": { "outputs": [] }
  }
}
