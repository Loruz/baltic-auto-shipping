{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["APP_ENV", "NODE_ENV"],
  "globalPassThroughEnv": ["DATABASE_URL", "REDIS_URL"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": { "outputs": [] }
  }
}
