# Fully offline local setup (IMPLEMENTATION-PLAN §6 "Local and demo environment").
# Copy to .env at the repo root: cp .env.example .env
APP_ENV=development

# Provider switches. Production values: apibara, ondato, stripe, resend, bot.
LOT_PROVIDER=fixtures
KYC_PROVIDER=fake
PAYMENT_PROVIDER=fake
EMAIL_TRANSPORT=smtp
TELEGRAM_TRANSPORT=log

# infra/compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bas
REDIS_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025

# Dev-only value; production refuses it. Generate a real one with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

APIBARA_API_KEY=
APIBARA_BASE_URL=

ONDATO_CLIENT_ID=
ONDATO_CLIENT_SECRET=
ONDATO_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM="Baltic Auto Shipping <no-reply@localhost>"
TELEGRAM_BOT_TOKEN=

# Cloudflare Turnstile published test keys (always pass)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

SENTRY_DSN=
BETTERSTACK_HEARTBEAT_URL=
