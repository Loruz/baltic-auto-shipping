# BullMQ worker. Build from the repo root:
#   docker build -f infra/docker/Dockerfile.worker -t bas-worker .
FROM node:24-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS pruned
COPY . .
RUN pnpm dlx turbo@2.11.13 prune @bas/worker --docker

FROM base AS build
COPY --from=pruned /repo/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruned /repo/out/full/ .
RUN pnpm --filter @bas/worker build \
 && pnpm --filter @bas/worker deploy --prod --legacy /deploy

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /deploy ./
USER node
CMD ["node", "dist/main.js"]
